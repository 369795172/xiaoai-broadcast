<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rootgrove.xiaoai-morning-play</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO_ROOT__/scripts/morning_play.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>58</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/CursorWorks/rootgrove/logs/xiaoai_morning.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/CursorWorks/rootgrove/logs/xiaoai_morning.log</string>
</dict>
</plist>
